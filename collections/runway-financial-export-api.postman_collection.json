    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Runway's limited Export API lets you programmatically export model pages (submodels) and database pages from a Runway workspace as CSV. It mirrors the manual CSV export available in the Runway app. Authentication uses a bearer API secret generated under workspace Settings > API. Only model (submodel) and database pages are supported; generic pages return an error.\n\nContact Support:\n Name: Runway Support\n Email: support@cfo.ai",
      "type": "text/plain"
    }
  }
